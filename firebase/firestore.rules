rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      let u = userDoc();
      return u.isActive == true && u.status == "approved";
    }

    function hasRole(role) {
      return isSignedIn() && isApproved() && userDoc().role == role;
    }

    function isAdmin()       { return hasRole("admin"); }
    function isSalesperson() { return hasRole("salesperson"); }
    function isDistributor() { return hasRole("distributor"); }
    function isSupervisor()  { return hasRole("supervisor"); }   // "Stock & Production"
    function isAccounts()    { return hasRole("accounts"); }

    // Prices are business-confidential: Admin and Accounts only (never Stock &
    // Production, salespeople or distributors).
    function canSeePrices()  { return isAdmin() || isAccounts(); }

    // A record someone creates for themselves (or a salesperson creates for a
    // distributor) must start unapproved — approval is an admin's decision.
    function isUnapprovedOnCreate() {
      let d = request.resource.data;
      return d.status == "pending"
          && d.get("approvedBy", null) == null
          && d.get("approvedAt", null) == null
          && d.get("deleted", false) == false;
    }

    function isStaff() {
      return isAdmin() || isSupervisor() || isSalesperson();
    }

    // ─── Users ────────────────────────────────────────────────────────────────

    match /users/{uid} {
      // Any signed-in user can read their own doc; admin/supervisor read all
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin() || isSupervisor());

      // Users create their own doc during signup — only as a pending salesperson
      // or distributor. Nobody can sign themselves up as admin/approved (C1).
      allow create: if isSignedIn() && request.auth.uid == uid
                    && isUnapprovedOnCreate()
                    && request.resource.data.role in ["salesperson", "distributor"];

      // Only admin can update user docs (covers approval batch write from frontend)
      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    // ─── Distributors ─────────────────────────────────────────────────────────

    match /distributors/{distributorId} {
      allow read: if isStaff()
                  || (isDistributor() && request.auth.uid == distributorId);

      // Salesperson creates on behalf of a distributor; distributor creates own doc
      // during signup. Either way it starts pending — only admin approves.
      allow create: if (isSalesperson() || (isSignedIn() && request.auth.uid == distributorId))
                    && isUnapprovedOnCreate();

      allow update: if isAdmin() || isSupervisor()
                    || (isSalesperson() && resource.data.createdBy == request.auth.uid);

      allow delete: if isAdmin();
    }

    // ─── Orders ───────────────────────────────────────────────────────────────

    match /orders/{orderId} {
      // Admin / supervisor / salesperson see all orders
      allow read: if isStaff()
                  // Distributor sees only their own orders
                  || (isDistributor() && resource.data.distributorId == request.auth.uid);

      // Salesperson creates orders on behalf of distributors
      allow create: if isSalesperson()
                    // Distributor places their own order
                    || (isDistributor() && request.resource.data.distributorId == request.auth.uid);

      // Only admin / supervisor can change order status
      allow update: if isAdmin() || isSupervisor();
      allow delete: if isAdmin();
    }

    // ─── Visits ───────────────────────────────────────────────────────────────

    match /visits/{visitId} {
      allow read:   if isStaff();
      allow create: if isSalesperson();
      allow update: if isAdmin() || isSupervisor()
                    || (isSalesperson() && resource.data.salespersonId == request.auth.uid);
      allow delete: if isAdmin()
                    || (isSalesperson() && resource.data.salespersonId == request.auth.uid);

      // Media subcollection: visits/{visitId}/media/{mediaId}
      match /media/{mediaId} {
        allow read:   if isStaff();
        allow create: if isSalesperson();
        allow update: if isAdmin() || isSupervisor()
                      || (isSalesperson() && get(/databases/$(database)/documents/visits/$(visitId)).data.salespersonId == request.auth.uid);
        allow delete: if isAdmin()
                      || (isSalesperson() && get(/databases/$(database)/documents/visits/$(visitId)).data.salespersonId == request.auth.uid);
      }
    }

    // ─── Products ─────────────────────────────────────────────────────────────

    match /products/{productId} {
      // All approved users can read the product catalogue (no prices in here —
      // they live in product_prices).
      allow read:  if isSignedIn() && isApproved();
      // Only Cloud Functions (Admin SDK) write products.
      allow write: if false;
    }

    match /product_prices/{sku} {
      // Dealer / distributor prices per product: Admin and Accounts only.
      allow read:  if canSeePrices();
      // Only Cloud Functions (Admin SDK) write prices.
      allow write: if false;
    }

    // ─── Public Catalog ───────────────────────────────────────────────────────

    match /public_catalog/{productKey} {
      // Price-free projection for the public marketing site — fully public.
      allow read:  if true;
      // Only the importProducts Cloud Function (Admin SDK) writes this.
      allow write: if false;
    }

    match /productChanges/{changeId} {
      // Append-only log of product edits from Technofluid Office (who, when,
      // old → new). Holds prices, so admin only. Written only by editProduct.
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ─── Stock (Technofluid Office) ───────────────────────────────────────────
    // Quantities only, no money. Admin, Accounts and Stock & Production can read;
    // only Cloud Functions write (the diary is append-only, corrections are new lines).

    function canSeeStock() { return isAdmin() || isAccounts() || isSupervisor(); }

    match /stockItems/{itemId} {
      allow read:  if canSeeStock();
      allow write: if false;
    }

    match /stockMovements/{movementId} {
      allow read:  if canSeeStock();
      allow write: if false;
    }

    match /stockRequests/{requestId} {
      // Retry bookkeeping for the stock functions — server only.
      allow read, write: if false;
    }

    // ─── Recipe changes (Technofluid Office) ──────────────────────────────────
    // Requests to change a product's recipe, approved by an Admin. No money.
    // Admin and Stock & Production read; only Cloud Functions write.

    match /recipeChangeRequests/{requestId} {
      allow read:  if isAdmin() || isSupervisor();
      allow write: if false;
    }

    // Production entries that changed a recipe, waiting for an Admin (or decided).
    match /productionRequests/{requestId} {
      allow read:  if isAdmin() || isSupervisor();
      allow write: if false;
    }

    // ─── Customers & suppliers ("entities") — office, with Humble Ledger ────────
    // Admin + Accounts read; only Cloud Functions write. Stock & Production never sees
    // customers, suppliers or money. Balances live in Humble Ledger, not here.

    match /entities/{entityId} {
      allow read:  if isAdmin() || isAccounts();
      allow write: if false;

      match /history/{historyId} {
        allow read:  if isAdmin() || isAccounts();
        allow write: if false;
      }
    }

    match /entityRequests/{requestId} {
      allow read, write: if false;
    }

    // ─── Money in & out — office, with Humble Ledger ─────────────────────────
    // Admin + Accounts read; only Cloud Functions write. No balances are stored here.

    match /moneyEntries/{entryId} {
      allow read:  if isAdmin() || isAccounts();
      allow write: if false;
    }

    match /registers/{registerId} {
      allow read:  if isAdmin() || isAccounts();
      allow write: if false;
    }

    match /expenseCategories/{categoryId} {
      allow read:  if isAdmin() || isAccounts();
      allow write: if false;
    }

    match /moneyRequests/{requestId} {
      allow read, write: if false;
    }

    // The emulator's stand-in for Humble Ledger — server only.
    match /_fakeHl/{document=**} {
      allow read, write: if false;
    }

    // ─── Coupons ──────────────────────────────────────────────────────────────

    match /coupons/{couponId} {
      // Distributors need to read coupons to validate them client-side
      allow read:  if isSignedIn() && isApproved();
      // Only admin creates / manages coupons
      allow write: if isAdmin();
    }

    // ─── Rate Lists ───────────────────────────────────────────────────────────

    // Legacy flat collection — kept for the migrateRateLists() one-time migration.
    match /rate_lists/{entryId} {
      allow read: if isStaff()
                  || (isDistributor() && resource.data.distributorId == request.auth.uid);
      allow write: if isAdmin();
    }

    // New subcollection structure: rate_lists/{distributorId}/products/{productId}
    match /rate_lists/{distributorId}/products/{productId} {
      // Any approved signed-in user can read rate entries.
      // Staff reads all; distributors read the global list and their own.
      allow read: if isSignedIn() && isApproved()
                  && (isStaff()
                      || distributorId == "global"
                      || distributorId == request.auth.uid);
      allow write: if isAdmin();
    }

    // ─── Admin Settings ───────────────────────────────────────────────────────

    match /admin_settings/{docId} {
      // All approved users read (salespersons need the GST API toggle in real-time)
      allow read:  if isSignedIn() && isApproved();
      // Only admin can change settings
      allow write: if isAdmin();
    }

    // ─── GST Cache ────────────────────────────────────────────────────────────

    match /gst_cache/{gstNumber} {
      allow read:  if isStaff();
      allow write: if isStaff();
    }

    // ─── Firms ────────────────────────────────────────────────────────────────

    match /firms/{firmId} {
      // All staff can read firms
      allow read: if isStaff();
      // Salespersons and admins can create and update firms
      allow create: if isSalesperson() || isAdmin();
      allow update: if isSalesperson() || isAdmin();
      allow delete: if isAdmin();

      // History subcollection: firms/{firmId}/history/{historyId}
      match /history/{historyId} {
        allow read:   if isStaff();
        allow create: if isSalesperson() || isAdmin();
        allow update: if isSalesperson() || isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ─── Contact messages (public website enquiry form) ───────────────────────

    match /contactMessages/{messageId} {
      // Anonymous visitors may create, but only with the exact expected shape.
      allow create: if
        request.resource.data.keys().hasOnly(
          ['name', 'phone', 'message', 'status', 'source', 'deleted',
           'createdAt', 'updatedAt']
        ) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 7 &&
        request.resource.data.phone.size() <= 20 &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 5 &&
        request.resource.data.message.size() <= 2000 &&
        request.resource.data.status == 'new' &&
        request.resource.data.source == 'website' &&
        request.resource.data.deleted == false;

      // Admin panel reads and works the queue; nobody else sees submissions.
      allow read, update: if isAdmin() || isSupervisor();
      allow delete: if isAdmin();
    }
  }
}
