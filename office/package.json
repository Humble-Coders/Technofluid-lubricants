{
  "name": "technofluid-office",
  "private": true,
  "description": "Technofluid Office \u2014 desktop accounting, stock and billing app (Electron) + shared core",
  "workspaces": [
    "core",
    "desktop"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w desktop",
    "build": "npm run build -w desktop",
    "emulators": "node emulator/start.mjs",
    "seed": "node emulator/seed.mjs",
    "test:emulator": "node emulator/run-tests.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "firebase-admin": "^13.6.0"
  }
}
