          { "type": "partyBlock", "paddingPt": 4.0, "gapAbovePt": 2.0, "lines": [
            { "label": "Party PAN", "value": { "field": "shipTo.pan" } },
            { "label": "Party Mobile No", "value": { "field": "shipTo.mobile" } },
            { "label": "Party AadhaarNo", "value": { "field": "shipTo.aadhaar" } },
            { "label": "GSTIN / UIN", "value": { "field": "shipTo.gstin" } }
