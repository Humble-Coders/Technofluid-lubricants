            { "segments": [ { "value": { "field": "tax2.label" }, "align": "center", "style": { "font": "italic" } }, { "value": { "field": "tax2.rate" }, "align": "right", "style": { "font": "italic" } } ] },
            { "segments": [ { "value": { "field": "roundOff.label" }, "align": "center", "style": { "font": "italic" } } ] }
          ]}
        ]},
        { "width": 72.0, "bands": [
          { "type": "textBand", "paddingPt": 3.0, "collapseEmptyLines": true, "lines": [
            { "segments": [ { "value": { "field": "taxableValue", "required": true }, "align": "right", "style": { "font": "bold" } } ] },
            { "segments": [ { "value": { "field": "tax1.amount" }, "align": "right" } ] },
            { "segments": [ { "value": { "field": "tax2.amount" }, "align": "right" } ] },
            { "segments": [ { "value": { "field": "roundOff.amount" }, "align": "right" } ] }
          ]}
        ]}
      ]
    },
    {
      "type": "columns",
      "border": true,
      "divider": true,
      "text": { "font": "bold", "sizePt": 9.5, "lineHeightPt": 12.5 },
