          { "type": "fieldGrid",
            "showWhen": "isInterState",
            "border": false,
            "cellPaddingPt": 3.0,
            "labelStyle": { "font": "bold", "sizePt": 7.5 },
            "valueStyle": { "sizePt": 7.5 },
            "rows": [ { "cells": [
              { "label": "Tax Rate", "value": { "field": "taxSummary.rate" }, "width": 50.0, "ruleLeft": false },
              { "label": "Taxable Amt.", "value": { "field": "taxSummary.taxable" }, "width": 75.0, "align": "right", "ruleLeft": false },
              { "label": "IGST Amt.", "value": { "field": "taxSummary.igst" }, "width": 65.0, "align": "right", "ruleLeft": false },
              { "label": "Total Tax", "value": { "field": "taxSummary.total" }, "width": 65.0, "align": "right", "ruleLeft": false },
              { "label": "", "value": { "text": "" }, "width": "*", "ruleLeft": false }
            ] } ]
