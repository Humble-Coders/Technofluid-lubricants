      "border": true,
      "paddingPt": 4.0,
      "lines": [
        { "segments": [ { "value": { "text": "Bank Details" }, "align": "center", "style": { "font": "bold", "sizePt": 9.5, "lineHeightPt": 12.0 } } ] },
        { "segments": [ { "value": { "field": "bank.line1" }, "align": "center", "style": { "sizePt": 7.5 } } ] },
        { "segments": [ { "value": { "field": "bank.line2" }, "align": "center", "style": { "sizePt": 7.5 } } ] }
      ]
    },
    {
      "type": "columns",
