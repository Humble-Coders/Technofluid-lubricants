        { "key": "slNo", "header": "S.N.", "width": 28.0, "align": "right", "headerAlign": "center" },
        { "key": "description", "header": "Description of Goods", "width": "*", "headerAlign": "left" },
        { "key": "hsn", "header": "HSN/SAC Code", "width": 58.0, "headerAlign": "left" },
        { "key": "qty", "header": "Qty.", "width": 44.0, "align": "right", "headerAlign": "right" },
        { "key": "unit", "header": "Unit", "width": 36.0, "headerAlign": "left" },
        { "key": "rate", "header": "Price", "width": 64.0, "align": "right", "headerAlign": "right" },
        { "key": "amount", "header": "Amount(₹)", "width": 72.0, "align": "right", "headerAlign": "right" }
