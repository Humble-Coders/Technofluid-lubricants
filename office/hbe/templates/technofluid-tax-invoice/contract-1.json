        { "segments": [ { "value": { "field": "seller.name", "required": true }, "align": "center", "style": { "font": "bold", "sizePt": 17.0, "lineHeightPt": 20.0 } } ] },
        { "segments": [ { "value": { "field": "seller.address" }, "align": "center", "style": { "sizePt": 8.5 } } ] },
        { "segments": [ { "value": { "field": "seller.panLine" }, "align": "center", "style": { "sizePt": 8.5 } } ] },
        { "segments": [ { "value": { "field": "seller.contactLine" }, "align": "center", "style": { "font": "boldItalic", "sizePt": 7.5 } } ] }
      ]
    },
    {
