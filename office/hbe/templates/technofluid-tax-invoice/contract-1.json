            { "label": "Dated", "value": { "field": "invoiceDate", "required": true } },
            { "label": "Place of Supply", "value": { "field": "placeOfSupply", "required": true } },
            { "label": "Reverse Charge", "value": { "field": "reverseCharge" } },
            { "label": "Transport", "value": { "field": "transport" } }
