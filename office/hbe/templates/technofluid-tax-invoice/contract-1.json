        { "segments": [
          { "value": { "field": "invoiceNo" } },
          { "value": { "text": "This is a computer-generated invoice." }, "align": "center" },
          { "value": { "text": "Page {page} of {pages}" }, "align": "right" }
        ] }
      ]
    }
  ],
  "bands": [
    {
      "type": "textBand",
      "border": true,
