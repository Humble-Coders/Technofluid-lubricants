            { "segments": [ { "value": { "field": "terms" } } ] }
          ]}
        ]},
        { "width": "*", "bands": [
          { "type": "textBand", "paddingPt": 4.0, "lines": [
            { "segments": [ { "value": { "text": "Receiver's Signature  :" }, "style": { "font": "bold", "sizePt": 7.0 } } ] }
          ]},
          { "type": "spacer", "heightPt": 0.5, "gapAbovePt": 18.0, "background": "#000000" },
          { "type": "signatoryBox", "heightPt": 52.0, "border": false,
            "topLines": [ { "segments": [ { "value": { "field": "signatoryFor" }, "align": "right", "style": { "font": "bold", "sizePt": 8.5 } } ] } ],
            "bottomLines": [ { "segments": [ { "value": { "text": "Authorised Signatory" }, "align": "right", "style": { "font": "bold", "sizePt": 8.0 } } ] } ] }
        ]}
      ]
    },
    {
      "type": "textBand",
      "paddingPt": 0,
      "gapAbovePt": 2.0,
      "text": { "sizePt": 6.5, "lineHeightPt": 8.5 },
