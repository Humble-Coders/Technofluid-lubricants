# Technofluid Firebase web config (public values, safe to ship in the app).
# Local only — not committed. Copy .env.example to recreate.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = talk to the local Firebase emulators (default for development), false = live project
VITE_USE_EMULATORS=true
