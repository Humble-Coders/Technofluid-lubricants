{
  "about": "Report rules — run by office/core (vitest). The `due` table ALSO runs against the Cloud Functions' paid-later filter (office/emulator/tests/money.test.mjs), so the app's \"still due\" and the server's can't drift. Made-up names only.",
  "due": [
    {
      "case": "partial: paid at billing + one payment later",
      "input": {
        "totalPaise": 100000,
        "paidAtCreationPaise": 20000,
        "linked": [
          {
            "amountPaise": 30000
          }
        ]
      },
      "expect": {
        "paidLaterPaise": 30000,
        "paidPaise": 50000,
        "duePaise": 50000
      }
    },
    {
      "case": "full at billing",
      "input": {
        "totalPaise": 100000,
        "paidAtCreationPaise": 100000,
        "linked": []
      },
      "expect": {
        "paidLaterPaise": 0,
        "paidPaise": 100000,
        "duePaise": 0
      }
    },
    {
      "case": "full through later payments",
      "input": {
        "totalPaise": 50000,
        "paidAtCreationPaise": 0,
        "linked": [
          {
            "amountPaise": 20000
          },
          {
            "amountPaise": 30000
          }
        ]
      },
      "expect": {
        "paidLaterPaise": 50000,
        "paidPaise": 50000,
        "duePaise": 0
      }
    },
    {
      "case": "reversed, mirror still PENDING: still counts (the books still have it as paid); the mirror itself never counts",
      "input": {
        "totalPaise": 100000,
        "paidAtCreationPaise": 0,
        "linked": [
          {
            "amountPaise": 40000,
            "reversedByEntryId": "m1",
            "mirrorStatus": "PENDING"
          },
          {
            "amountPaise": 40000,
            "reversesEntryId": "e1"
          }
        ]
      },
      "expect": {
        "paidLaterPaise": 40000,
        "paidPaise": 40000,
        "duePaise": 60000
      }
    },
    {
      "case": "reversed, mirror FAILED: still counts",
      "input": {
        "totalPaise": 100000,
        "paidAtCreationPaise": 0,
        "linked": [
          {
            "amountPaise": 40000,
            "reversedByEntryId": "m1",
            "mirrorStatus": "FAILED"
          }
        ]
      },
      "expect": {
        "paidLaterPaise": 40000,
        "paidPaise": 40000,
        "duePaise": 60000
      }
    },
    {
      "case": "reversed, mirror status not known yet: still counts",
      "input": {
        "totalPaise": 100000,
        "paidAtCreationPaise": 0,
        "linked": [
          {
            "amountPaise": 40000,
            "reversedByEntryId": "m1",
            "mirrorStatus": null
          }
        ]
      },
      "expect": {
        "paidLaterPaise": 40000,
        "paidPaise": 40000,
        "duePaise": 60000
      }
    },
    {
      "case": "reversed, mirror SYNCED: stops counting",
      "input": {
        "totalPaise": 100000,
        "paidAtCreationPaise": 0,
        "linked": [
          {
            "amountPaise": 40000,
            "reversedByEntryId": "m1",
            "mirrorStatus": "SYNCED"
          },
          {
            "amountPaise": 40000,
            "reversesEntryId": "e1"
          }
        ]
      },
      "expect": {
        "paidLaterPaise": 0,
        "paidPaise": 0,
        "duePaise": 100000
      }
    },
    {
      "case": "deleted entry never counts",
      "input": {
        "totalPaise": 100000,
        "paidAtCreationPaise": 0,
        "linked": [
          {
            "amountPaise": 25000,
            "deleted": true
          },
          {
            "amountPaise": 10000
          }
        ]
      },
      "expect": {
        "paidLaterPaise": 10000,
        "paidPaise": 10000,
        "duePaise": 90000
      }
    },
    {
      "case": "more paid than the total: due stays at zero",
      "input": {
        "totalPaise": 10000,
        "paidAtCreationPaise": 6000,
        "linked": [
          {
            "amountPaise": 5000
          }
        ]
      },
      "expect": {
        "paidLaterPaise": 5000,
        "paidPaise": 11000,
        "duePaise": 0
      }
    }
  ],
